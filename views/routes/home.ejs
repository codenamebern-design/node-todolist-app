<%- include('../components/head.ejs') %>
<body>
  <%- include('../components/nav.ejs') %>
  <main>
    <h1>Tasks</h1>

    <% if (task.length === 0) { %>
      <p class="empty">Nothing to do. Enjoy the quiet.</p>
    <% } else { %>
      <ul class="tasks">
        <% task.forEach(t => { %>
          <li>
            <div class="task-info">
              <span><%= t.task %></span>
              <span class="task-date"><%= t.date %></span>
            </div>
            <div class="actions">
              <a href="/edit/<%= t._id %>">Edit</a>
              <form action="/delete/<%= t._id %>" method="post"
                    onsubmit="return confirm('Delete this task?')">
                <button type="submit" class="link-btn danger">Done</button>
              </form>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </main>
  <%- include('../components/footer.ejs') %>
</body>
</html>